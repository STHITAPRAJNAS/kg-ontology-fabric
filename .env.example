# Copy to .env when cloning and self-hosting via `kg-fabric serve` or `docker compose --profile app up -d`

# 1. PostgreSQL + pgvector (leave blank to run with in-memory emulator)
PGHOST=127.0.0.1
PGPORT=5434
PGDATABASE=enterprise_kg_fabric
PGUSER=kg_admin
PGPASSWORD=

# 2. Property Graph Backend: memory | neo4j | neptune
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEPTUNE_ENDPOINT=https://your-neptune-cluster.region.neptune.amazonaws.com:8182
# AWS_REGION=us-east-1

# 3. Authentication, OIDC/JWKS, ABAC & Legacy Table Allowlist: none | api_key | jwt
KG_FABRIC_AUTH_MODE=none
# KG_FABRIC_API_KEYS={"replace-me-with-secret-key":{"subject":"svc-agent","tenant_id":"acme","acl_groups":["public"],"roles":["reader","writer"]}}
# KG_FABRIC_JWT_SECRET=
# KG_FABRIC_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# KG_FABRIC_JWT_ISSUER=
# KG_FABRIC_JWT_AUDIENCE=
# KG_FABRIC_JWT_ALGORITHMS=HS256
# Fail-closed allowlist of physical Postgres tables readable via EXISTING_PGVECTOR_KB (empty = disabled):
# KG_FABRIC_ALLOWED_LEGACY_TABLES=public.legacy_*
# Optional multi-DB DSN alias map for cross-database pgvector federation:
# KG_FABRIC_PG_DSN_ALIASES={"finops_db":"postgresql://user:pass@host:5432/finops"}

# 4. Embeddings, Domain Pack & Optional Live LLM Extraction/Induction/Cypher/Synthesis
# Embeddings: hash (zero-key default) | gemini | openai | bedrock | sentence_transformers
KG_FABRIC_EMBEDDING_PROVIDER=hash
# KG_FABRIC_EMBEDDING_MODEL=text-embedding-3-small
# Built-in domain packs: cloud_sre | generic
KG_FABRIC_DOMAIN_PACK=cloud_sre
KG_FABRIC_USE_LIVE_LLM=false
KG_FABRIC_LLM_PROVIDER=gemini
KG_FABRIC_LLM_MODEL=gemini-2.5-flash
KG_FABRIC_LLM_CONCURRENCY=8
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# 5. Microsoft Presidio PII Redaction: replace_tag | hmac_pseudonymize
PII_REDACTION_MODE=replace_tag
# PII_HMAC_SECRET_KEY=
